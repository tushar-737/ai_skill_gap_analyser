# =====================================================
# AI Skill Gap Analyzer — Backend environment
# Copy to .env and fill in real values. Never commit .env
# =====================================================

# Database — MySQL (pymysql). Use either DATABASE_URL or all DB_* values.
# DATABASE_URL=mysql+pymysql://app_user:strong_password@localhost:3306/ai_skill_gap
DB_USER=root
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_skill_gap

# API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# AI — Provider switch (groq is recommended for free tier: 30 RPM vs Gemini 15 RPM)
# Set AI_PROVIDER to: gemini | groq | auto (default auto: tries groq, then gemini, then keyword)
AI_PROVIDER=auto

# Groq (fast, generous free tier) — get at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier) — get at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Feature flags
# Set DEBUG=true to enable /api/debug-db (never in production)
DEBUG=false

# Privacy: extracted skills are saved for the browser's private upload history.
# Leave false to avoid persisting raw resume text in the database.
STORE_RESUME_TEXT=false

# Abuse protection (in-memory, per client IP, per window). For a multi-server
# deployment, enforce equivalent limits at the API gateway or with Redis.
RATE_LIMIT_WINDOW_SECONDS=60
RESUME_ANALYZE_LIMIT=5
AI_ROADMAP_LIMIT=15
# Enable only when your reverse proxy overwrites X-Forwarded-For safely.
TRUST_PROXY_HEADERS=false
