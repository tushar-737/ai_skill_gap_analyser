# =====================================================
# AI Skill Gap Analyzer — Backend environment
# Copy to .env and fill in real values. Never commit .env
# =====================================================

# Database — MySQL (pymysql)
DB_USER=root
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_skill_gap

# API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# AI — Google Gemini (free tier)
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Feature flags
# Set DEBUG=true to enable /api/debug-db (never in production)
DEBUG=false
