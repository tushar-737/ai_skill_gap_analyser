# Copy to .env before running Docker Compose. Do not commit real values.
DB_NAME=ai_skill_gap
DB_USER=skillgap
DB_PASSWORD=replace_with_a_long_unique_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_root_password
FRONTEND_PORT=8080

# Relative /api requests are proxied by Nginx, so this is normally localhost.
ALLOWED_ORIGINS=http://localhost:8080

# Use keyword mode by default; add a provider key only when needed.
AI_PROVIDER=keyword
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Privacy and abuse-protection settings.
STORE_RESUME_TEXT=false
RATE_LIMIT_WINDOW_SECONDS=60
RESUME_ANALYZE_LIMIT=5
AI_ROADMAP_LIMIT=15
